{
  "name": "@buildscaffold/github-task",
  "version": "0.0.0",
  "description": "Tasks for creating and configuring GitHub repositories after a scaffold runs",
  "type": "module",
  "exports": {
    ".": {
      "@buildscaffold/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@octokit/rest": "^20.1.1"
  },
  "peerDependencies": {
    "@buildscaffold/task": "workspace:^"
  },
  "devDependencies": {
    "@buildscaffold/core": "workspace:*",
    "@buildscaffold/task": "workspace:*",
    "@jameslnewell/eslint-config": "^8.0.0",
    "@jameslnewell/vitest-config": "^8.0.0",
    "@types/node": "^24.19.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "check:linting": "eslint .",
    "check:typing": "tsc",
    "fix:linting": "eslint --fix .",
    "test": "vitest run --project unit"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
