{
  "name": "@jameslnewell/scaffold",
  "version": "0.1.0",
  "description": "A tool for scaffolding your projects",
  "type": "module",
  "bin": {
    "scaffold": "dist/cli.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "!dist/examples"
  ],
  "dependencies": {
    "@inquirer/confirm": "^3.1.9",
    "@inquirer/prompts": "^5.0.5",
    "@octokit/rest": "^20.1.1",
    "ejs": "^3.1.10",
    "import-meta-resolve": "^4.2.0",
    "picomatch": "^4.0.2",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/cli": "^0.3.10",
    "@swc/core": "^1.4.8",
    "@swc/jest": "^0.2.36",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.0.3",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^2.3.3",
    "@types/yargs": "^17.0.35",
    "chokidar": "^3.6.0",
    "jest": "^29.0.3",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest"
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "scripts": {
    "check:typing": "tsc",
    "build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && pnpm run build:js && pnpm run build:types && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "build:js": "swc ./src --strip-leading-paths --out-dir ./dist --ignore \"**/*.test.ts\"",
    "build:types": "tsc -p tsconfig.build.json",
    "develop": "pnpm run build:js --watch",
    "example:greeting": "node -e \"fs.mkdirSync('tmp/greeting', {recursive: true})\" && node ./dist/cli.js ../../dist/examples/greeting.js --cwd ./tmp/greeting --apply -- --name Bob",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
