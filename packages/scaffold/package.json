{
  "name": "@jameslnewell/scaffold",
  "version": "0.1.0",
  "description": "A tool for scaffolding your projects",
  "type": "module",
  "bin": {
    "scaffold": "dist/cli.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "!dist/examples"
  ],
  "dependencies": {
    "@inquirer/confirm": "^3.1.9",
    "@inquirer/prompts": "^5.0.5",
    "@octokit/rest": "^20.1.1",
    "cross-spawn": "^7.0.6",
    "ejs": "^3.1.10",
    "import-meta-resolve": "^4.2.0",
    "picomatch": "^4.0.2",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@jameslnewell/eslint-config": "^8.0.0",
    "@jameslnewell/vitest-config": "^8.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^2.3.3",
    "@types/yargs": "^17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "check:linting": "eslint .",
    "check:typing": "tsc",
    "fix:linting": "eslint --fix .",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && chmod +x ./dist/cli.js",
    "develop": "tsc -p tsconfig.build.json --watch",
    "example:greeting": "mkdir -p ./tmp/greeting && node ./dist/cli.js \"$PWD/dist/examples/greeting.js\" --cwd ./tmp/greeting --apply -- --name Bob",
    "test": "vitest run --project unit"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
